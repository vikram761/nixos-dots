{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	    "source": "$(ls ~/.config/fastfetch/images/*.png | shuf -n 1)",
	    "type": "kitty-direct",
	    "width": 16,
	    "padding": {
		    "top": 0,
            "left": 0
	    }
    },
    "display": {
        "separator": " ›  "
    },
    "modules": [
	    "break",
        "break",
        "break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "36"
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "36"
        },
        {
            "type": "packages",
            "format": "{} (nixpkgs)",
            "key": "PKG ",
            "keyColor": "36"
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "36"
        },
        {
            "type": "terminal",
            "key": "TER ",
            "keyColor": "36"
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "36"
        },
        "break"
    ]
}
